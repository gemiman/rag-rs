# 复制本文件为 .env 并填入真实值

# 阿里云百炼（DashScope）API Key（在阿里云百炼控制台获取）
OPENAI_API_KEY=在这里填你的百炼APIKey
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 模型配置
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3

# 服务配置
DATABASE_URL=sqlite:data/rag.db
HOST=127.0.0.1
PORT=8000

# JWT 签名密钥（请改成一段随机字符串）
JWT_SECRET=请改成一段随机字符串
