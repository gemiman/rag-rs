#!/bin/sh
# 提交前门禁：要求「单元测试」和「质量检查」都通过，否则拒绝提交
GATES=".git/quality-gates"

fail() {
  echo ""
  echo "❌ 提交被拦截：$1"
  echo "   请先对 Claude 说「提交」，让 gitcommit-agent 跑一遍测试和质量检查。"
  echo ""
  exit 1
}

[ -f "$GATES/tests.status" ] || fail "没有单元测试的通过标记"
[ "$(cat "$GATES/tests.status")" = "pass" ] || fail "单元测试未通过"
[ -f "$GATES/quality.status" ] || fail "没有质量检查的通过标记"
[ "$(cat "$GATES/quality.status")" = "pass" ] || fail "质量检查未通过"

echo "✅ 单元测试 + 质量检查均已通过，允许提交。"
exit 0
